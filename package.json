{
  "name": "f5",
  "version": "0.1.0",
  "private": true,
  "description": "F5 - Independent platform (web + api + mobile)",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "turbo run dev --filter=@f5/api",
    "dev:web": "turbo run dev --filter=@f5/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm -F @f5/api exec prisma generate",
    "db:migrate": "pnpm -F @f5/api exec prisma migrate deploy",
    "db:seed": "pnpm -F @f5/api exec prisma db seed",
    "db:seed:pilot": "pnpm -F @f5/api exec tsx prisma/seed-pilot.ts",
    "gate2:validate": "pnpm -F @f5/web gate2:validate",
    "db:recalc-dashboard": "pnpm -F @f5/web db:recalc-dashboard"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
