# Admin (required for /admin on Vercel without Supabase)
ADMIN_PASSWORD=change-me-to-a-strong-password
# Optional — defaults to admin@f5digital.com.br
ADMIN_EMAIL=admin@f5digital.com.br
# Optional — session cookie value; defaults to ADMIN_PASSWORD if unset
# ADMIN_SECRET=your-random-session-token

# Supabase Auth — portal cliente multi-tenant (projeto F5, separado do imobi)
# Quando URL + ANON_KEY estão setados: login por email/senha; tenant vem de User.tenantId no Prisma.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
#
# Setup:
# 1. Criar projeto em supabase.com (só Auth — banco de dados é Neon/Prisma via DATABASE_URL)
# 2. Settings → API → copiar Project URL e anon public key para as vars acima
# 3. pnpm db:seed — anota emails e senha dev no console
# 4. Supabase → Authentication → Users → Add user (Auto confirm) para cada email:
#      piloto-a@f5.internal   → PET Piloto Nutri
#      piloto-b@f5.internal   → PET Piloto Extru
#      piloto-saude@f5.internal / piloto-papel@f5.internal (opcional)
#    Senha dev (seed): F5-Piloto-Dev2026!
#
# Sem Supabase: use CLIENT_PORTAL_PASSWORD + CLIENT_PORTAL_SECRET (ver .env.example na raiz)

# Database (admin interno — sem URL usa store em memória)
# DATABASE_URL=postgresql://user:password@localhost:5432/f5_dev

# API
NEXT_PUBLIC_API_URL=http://localhost:3001

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Logging / observability (opcional — ativa só com DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
