# Admin (required for /admin on Vercel without Supabase)
ADMIN_PASSWORD=Adminf5@123
# Optional — defaults to admin@f5digital.com.br
ADMIN_EMAIL=admin@f5digital.com.br
# Optional — session cookie value (required on Vercel production; must differ from ADMIN_PASSWORD)
# Generate: openssl rand -hex 32
# ADMIN_SECRET=your-random-session-token

# Supabase Auth — portal cliente multi-tenant (projeto F5, separado do imobi)
# Copie valores reais do Supabase Dashboard → Connect (nunca commitar secret key).
#
# Server SDK (@supabase/server) — prefer these names:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Ou inline: SUPABASE_JWKS={"keys":[...]}
#
# Browser (Next.js) — publishable key também exposto ao client:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# Legacy (Vercel pode ainda ter — SDK faz bridge automático):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
#
# Setup:
# 1. Criar projeto em supabase.com (Auth — banco principal é Neon/Prisma)
# 2. Dashboard → Connect → copiar URL, publishable key, secret key, JWKS URL
# 3. pnpm db:seed — emails piloto no console
# 4. Supabase → Authentication → Users (ou pnpm db:seed:users):
#      demo.nutri@f5digital.com.br   → PET Piloto Nutri
#      demo.extru@f5digital.com.br   → PET Piloto Extru
#    Senha demo: F5Demo2026!
#
# Route handlers: import { withSupabaseRoute } from '@/lib/supabase'
# Edge Functions: import { withSupabase } from '@supabase/server'
#
# Sem Supabase: use CLIENT_PORTAL_PASSWORD + CLIENT_PORTAL_SECRET (raiz .env.example)

# Database (admin interno — sem URL usa store em memória)
# DATABASE_URL=postgresql://user:password@localhost:5432/f5_dev

# API
NEXT_PUBLIC_API_URL=http://localhost:3001

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Logging / observability — Sentry (org imobi-hl, projeto f5-web)
# Client + server (obrigatório na Vercel para ativar):
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx
# SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx
#
# Source maps no build (opcional — ver docs/MANUAL_SETUP.md §4):
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=imobi-hl
# SENTRY_PROJECT=f5-web
