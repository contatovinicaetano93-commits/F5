# Banco de dados (Neon PostgreSQL)
DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASS@HOST/neondb?sslmode=require

# Admin interno F5
ADMIN_EMAIL=admin@f5digital.com.br
ADMIN_PASSWORD=trocar-em-producao
ADMIN_SECRET=gerar-com-openssl-rand-hex-32

# Portal cliente (fallback sem Supabase)
CLIENT_PORTAL_PASSWORD=trocar-em-producao
CLIENT_PORTAL_SECRET=gerar-com-openssl-rand-hex-32
CLIENT_DEMO_TENANT_ID=

# Supabase Auth
SUPABASE_URL=https://SEU-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://SEU-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URLs
NEXT_PUBLIC_APP_URL=https://app.f5digital.com.br
NEXT_PUBLIC_API_URL=https://app.f5digital.com.br
NODE_ENV=development

# Sentry (opcional em dev, obrigatório em prod)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=f5-web
SENTRY_AUTH_TOKEN=

# Cron jobs (Vercel)
CRON_SECRET=gerar-com-openssl-rand-hex-32

# Email (Resend) — opcional; stub ativo sem RESEND_API_KEY
RESEND_API_KEY=
RESEND_FROM_EMAIL=F5 Digital <insights@f5digital.com.br>
