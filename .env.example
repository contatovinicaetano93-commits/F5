# Database
DATABASE_URL="postgresql://f5_user:f5_password@localhost:5432/f5_dev"

# Admin
ADMIN_PASSWORD="your-admin-password"
ADMIN_SECRET="local-dev-secret-change-in-production"
ADMIN_EMAIL="admin@f5digital.com.br"

# Portal cliente — escolha UM modo (Supabase tem prioridade se ambos estiverem setados):
#
# A) Supabase Auth — ver apps/web/.env.example (SUPABASE_URL + publishable + secret + JWKS)
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SUPABASE_SECRET_KEY="sb_secret_..."
# SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Após db:seed, criar usuários no Supabase Auth com emails do seed (ex.: piloto-a@f5.internal)
# Senha dev documentada no output de pnpm db:seed (F5-Piloto-Dev2026!)
#
# B) Senha única do portal (fallback sem Supabase)
CLIENT_PORTAL_PASSWORD="portal-dev-password"
CLIENT_PORTAL_SECRET="local-client-portal-secret"
# CLIENT_DEMO_TENANT_ID=""   # só modo B / demo dev — ignorado quando Supabase está configurado
# CLIENT_DEMO_TENANT_NAME="PET Piloto Nutri"

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRE="24h"

# Marketplace APIs
MERCADO_LIVRE_API_KEY="your-ml-api-key"
MERCADO_LIVRE_API_SECRET="your-ml-api-secret"
AMAZON_ACCESS_KEY="your-amazon-key"
AMAZON_SECRET_KEY="your-amazon-secret"

# AWS S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret"
AWS_S3_BUCKET="f5-marketplace-bucket"

# Environment
NODE_ENV="development"
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# Logging
LOG_LEVEL="debug"
