# Database
DATABASE_URL="postgresql://f5_user:f5_password@localhost:5432/f5_dev"

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRE="24h"

# Marketplace APIs
MERCADO_LIVRE_API_KEY="your-ml-api-key"
MERCADO_LIVRE_API_SECRET="your-ml-api-secret"
AMAZON_ACCESS_KEY="your-amazon-key"
AMAZON_SECRET_KEY="your-amazon-secret"

# AWS S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret"
AWS_S3_BUCKET="f5-marketplace-bucket"

# Environment
NODE_ENV="development"
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# Logging
LOG_LEVEL="debug"
